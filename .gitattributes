# Переводы строк нормализуем: сторонний пакет Toony Colors Pro пришёл
# с CRLF и без этого сыпет предупреждениями на каждой операции.
* text=auto eol=lf

# Unity-ассеты — это YAML. Помечаем текстом явно, чтобы работали диффы:
# именно ради читаемых диффов в проекте включён ForceText.
*.unity      text
*.prefab     text
*.asset      text
*.mat        text
*.anim       text
*.controller text
*.mask       text
*.physicMaterial text
*.meta       text

# Бинарное. Без этой пометки git попытается нормализовать переводы строк
# внутри модели или текстуры и испортит файл.
*.fbx  binary
*.FBX  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.JPEG binary
*.psd  binary
*.tga  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.so   binary
*.apk  binary
